+/* GEMELO: cada 40 ms publica [Q1 Q2 Q3 Q4 CAL] (misma lectura que
+ * limits_publish_tick, sin texto y sin esperar cambios). */
+static void joints_timer_cb(rcl_timer_t *timer, int64_t last_call_time)
+{
+    (void)last_call_time;
+    if (timer == NULL) return;
+    joints_t q;
+    control_get_position(&q);
+    joints_buf[0] = q.th1 * 57.2957795f;                 /* Q1 [grados] */
+    joints_buf[1] = q.th2 * 57.2957795f;                 /* Q2 [grados] */
+    joints_buf[2] = q.th3;                               /* Q3 [mm desde el piso] */
+    joints_buf[3] = (float)effector_servo_deg();         /* Q4 [grados] */
+    joints_buf[4] = (homing_pro_calibrated(0) && homing_pro_calibrated(1) &&
+                     homing_pro_calibrated(2)) ? 1.0f : 0.0f;   /* CAL */
+    joints_msg.data.data = joints_buf;
+    joints_msg.data.size = JOINTS_LEN;
+    joints_msg.data.capacity = JOINTS_LEN;
+    RCSOFT(rcl_publish(&joints_pub, &joints_msg, NULL));
+}
